# singing-service — variables de entorno (copiar a .env y ajustar).
# Canonical: el Core lee SINGING_SERVICE_URL; si usa otro nombre, se actualiza
# este documento, NO el código del servicio.
SINGING_SERVICE_URL=http://singing-service:5000

# Límites de subida (O2: 50 MB / 10 min)
MAX_FILE_MB=50
MAX_DURATION_SEC=600

# Almacén stateless
ANALYSIS_TTL_SECONDS=3600

# Algoritmo
HOP_LENGTH=512
CENT_THRESHOLD=50
FFMPEG_BINARY=   # opcional: ruta al binario si no está en el PATH

# Concurrencia (mode real)
MAX_CONCURRENT_ANALYSES=2
BUSY_TIMEOUT_SEC=30
