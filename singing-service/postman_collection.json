      "name": "GET /api/v1/analyze/{analysis_id}",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('score vocal presente', () => pm.expect(body.scores.vocal).to.be.a('number'));",
              "pm.test('no_voice != out_of_tune', () => {",
              "  const tipos = body.segments.map(s => s.type);",
              "  pm.expect(tipos).to.include('no_voice');",
              "  pm.expect(tipos).to.include('out_of_tune');",
              "});"
            ]
          }
        }
